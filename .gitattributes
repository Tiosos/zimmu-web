# Normalize line endings. Without this, core.autocrlf=true leaves CRLF in the working tree
# while Prettier writes LF, so `prettier --check` fails on every file for reasons that have
# nothing to do with formatting (122 files vs the 5 that were genuinely unformatted).
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.wasm binary
*.stl binary
*.step binary
